VITE_SUPABASE_URL=https://etvnsrvenbsqxhosmuhw.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-dashboard
# Bot username from @BotFather, without the @, plus the Mini App "short
# name" you gave it via /newapp — together they build referral links as
# t.me/<username>/<shortname>?startapp=<code>. Both are required: the plain
# t.me/<username>?startapp= form 400s with BOT_INVALID once the bot has a
# registered Mini App (rather than just a Menu Button URL). Referral cards
# still work without these set, they just show the raw code instead.
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
VITE_TELEGRAM_MINIAPP_SHORTNAME=your_app_shortname
